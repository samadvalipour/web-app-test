{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-test",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "34844473-6167-4c66-9d75-2e1fb4f6b750","database_name": "web-app-test" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b4212e93f44b4364aaca3877172809ad" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
